# book-to-skill — provider configuration (API mode only)
# Copy to .env and fill the values for the provider(s) you use.
# Skill mode needs NONE of these (the Claude Code agent does the synthesis).
#
# Select a provider with --provider <name> or BOOK_TO_SKILL_PROVIDER.
BOOK_TO_SKILL_PROVIDER=

# --- OpenAI-compatible providers (one adapter, switched by base_url) ---

# OpenAI            https://api.openai.com/v1
OPENAI_API_KEY=

# OpenRouter        https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Groq Cloud        https://api.groq.com/openai/v1   (default model: openai/gpt-oss-20b)
GROQ_API_KEY=

# xAI Grok          https://api.x.ai/v1
XAI_API_KEY=

# DeepSeek          https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# Qwen / DashScope  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Ollama (local)    http://localhost:11434/v1   (no key required)
# (no env var needed)

# Generic local / OpenAI-compatible endpoint: pass --base-url and optionally:
LOCAL_API_KEY=

# --- Dedicated adapters ---

# Anthropic (Claude Messages API)   https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=

# Google Gemini                     https://generativelanguage.googleapis.com
GEMINI_API_KEY=
